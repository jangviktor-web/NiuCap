# ============================================================================
# 数据库配置（可选）
#
# 复制本文件为 .env，填好下面的变量，程序就会自动从本地 SQLite 切换到
# 云端 MySQL 协议库（TiDB Cloud / MySQL / MariaDB 均可）。
#
# 想切回本地：把 TICK_DB_HOST 注释掉，或直接删掉 .env。
# 本地数据始终保留在 data/tick.db，不会被删除。
# ============================================================================

# 主机地址填你实际的服务地址，形如：
#   <前缀>.prod.<地域>.tidbcloud.com   或   <你的域名/IP>
# 不要照抄这里的示例值，它是占位符。
TICK_DB_HOST=your-db-host.example.com
TICK_DB_PORT=4000
TICK_DB_USER=你的用户名
TICK_DB_PASSWORD=你的密码
TICK_DB_NAME=tick

# TLS 加密。TiDB Cloud 建议开启（1=开，0=关）
TICK_DB_SSL=1

# ============================================================================
# 日线落库 · 每日自动（可选）
#
# 打开后服务会每天定时把全市场日线写入数据库，不用再手动点按钮。
# 也可以在后台管理页「运行参数」里改，管理页设置优先于这里的环境变量。
# ============================================================================

# 是否开启（1=开，0=关）。默认关。
TICK_SYNC_BARS_AUTO=0

# 每天几点跑，24 小时制 HH:MM。
# 注意 A 股 15:00 收盘、盘后结算需要时间，15:30 执行时当日 K 线可能不完整。
# 写入按 (代码, 日期) 幂等覆盖，次日再跑会修正，不会累积脏数据。
TICK_SYNC_BARS_AT=15:30

# 每只拉多少根日线（250 ≈ 1 年）
TICK_SYNC_BARS_COUNT=250

# 股票池：all=全市场（约 5575 只，含北交所）/ hs300 / zz500 / zz1000 / zz2000
TICK_SYNC_BARS_SCOPE=all

# ============================================================================
# 虚拟盘费率
#
# 注意：这几个**不是**全局参数，只是「新用户开户时的默认值」。
# 注册那一刻会写到 users 表的 5 个列里固化下来，之后每个用户在
# 「虚拟盘 → 费率设置」里各改各的，改这里不影响已开户的人。
#
# ETF / 场内基金免印花税是税法规定，**没有**对应的可配项。
# ============================================================================

# 股票佣金费率（0.00025 = 万 2.5，双向收取）
TICK_FEE_RATE=0.00025

# 股票单笔最低佣金（元）
TICK_FEE_MIN=5.0

# 印花税率（0.0005 = 千 0.5，仅卖出收取）
TICK_STAMP_RATE=0.0005

# ETF 佣金费率
TICK_ETF_FEE_RATE=0.00025

# ETF 单笔最低佣金（元）
TICK_ETF_FEE_MIN=5.0

# ============================================================================
# 安全提示
#
# 这个 .env 内含数据库密码，务必加入 .gitignore，不要提交到任何代码仓库。
# 如果密码曾经出现在聊天记录、日志或提交记录里，请去控制台轮换一次。
# ============================================================================
